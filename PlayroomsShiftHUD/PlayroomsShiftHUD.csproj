<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>PlayroomsShiftHUD</AssemblyName>
    <RootNamespace>ComfortCode.Playrooms.ShiftHUD</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <Version>0.1.0</Version>
    <Deterministic>true</Deterministic>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <GameDir Condition="'$(GameDir)' == ''">C:/Program Files (x86)/Steam/steamapps/common/Playrooms</GameDir>
    <BepInExCore>$(GameDir)/BepInEx/core</BepInExCore>
    <GameInterop>$(GameDir)/BepInEx/interop</GameInterop>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src/*.cs" />
    <Reference Include="$(BepInExCore)/*.dll" Private="false" />
    <Reference Include="$(GameInterop)/*.dll" Private="false" />
  </ItemGroup>
  <Target Name="RequireGameReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(BepInExCore)/BepInEx.Unity.IL2CPP.dll')"
           Text="Missing BepInEx IL2CPP core at $(BepInExCore)." />
    <Error Condition="!Exists('$(GameInterop)/Il2Cppmscorlib.dll')"
           Text="Missing Playrooms IL2CPP interop at $(GameInterop)." />
    <Error Condition="!Exists('$(GameInterop)/UnityEngine.IMGUIModule.dll')"
           Text="Missing UnityEngine.IMGUIModule.dll." />
  </Target>
</Project>
