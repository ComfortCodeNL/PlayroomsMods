<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Playrooms</GameDir>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>PlayroomsPatcher</AssemblyName><RootNamespace>PlayroomsPatcher</RootNamespace>
    <LangVersion>latest</LangVersion><AllowUnsafeBlocks>true</AllowUnsafeBlocks><Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems><DebugType>none</DebugType><Deterministic>true</Deterministic>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences><NoStdLib>true</NoStdLib>
    <Version>1.0.0</Version>
  </PropertyGroup>
  <ItemGroup><Compile Include="src/*.cs" /></ItemGroup>
  <ItemGroup>
    <Reference Include="$(GameDir)/dotnet/System.*.dll" Private="false" />
    <Reference Include="$(GameDir)/dotnet/mscorlib.dll" Private="false" />
    <Reference Include="$(GameDir)/dotnet/netstandard.dll" Private="false" />
    <Reference Include="$(GameDir)/dotnet/Microsoft.Extensions.Logging.Abstractions.dll" Private="false" />
    <Reference Include="$(GameDir)/BepInEx/core/BepInEx.Core.dll" Private="false" />
    <Reference Include="$(GameDir)/BepInEx/core/BepInEx.Preloader.Core.dll" Private="false" />
    <Reference Include="$(GameDir)/BepInEx/core/BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(GameDir)/BepInEx/core/BepInEx.Unity.Common.dll" Private="false" />
    <Reference Include="$(GameDir)/BepInEx/core/Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(GameDir)/BepInEx/core/Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(GameDir)/BepInEx/core/Il2CppInterop.Generator.dll" Private="false" />
    <Reference Include="$(GameDir)/BepInEx/core/AsmResolver*.dll" Private="false" />
    <Reference Include="$(GameDir)/BepInEx/core/0Harmony.dll" Private="false" />
    <Reference Include="$(GameDir)/BepInEx/core/AssetRipper.Primitives.dll" Private="false" />
  </ItemGroup>
</Project>
