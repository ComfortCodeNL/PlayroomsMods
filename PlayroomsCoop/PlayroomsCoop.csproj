<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework><AssemblyName>PlayroomsCoop</AssemblyName><RootNamespace>PlayroomsCoop</RootNamespace>
    <LangVersion>latest</LangVersion><AllowUnsafeBlocks>true</AllowUnsafeBlocks><Nullable>disable</Nullable><ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems><DebugType>none</DebugType><Deterministic>true</Deterministic>
    <Version>1.1.1</Version><TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup><Compile Include="src/*.cs" /></ItemGroup>
  <ItemGroup>
    <Reference Include="../refs/*.dll" Private="false" />
  </ItemGroup>
</Project>
